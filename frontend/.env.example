# ---------------------------------------------------------------------------
# Kampusly Frontend — Browser-Exposed Environment Template
# Copy to `frontend/.env` for standalone local Vite development:
#   cp frontend/.env.example frontend/.env
#
# SECURITY WARNING:
# Only variables prefixed with `VITE_` are exposed to the browser bundle.
# NEVER put database credentials, SMTP passwords, or private keys here.
# ---------------------------------------------------------------------------

VITE_APP_NAME=Kampusly
VITE_API_BASE_URL=http://localhost:8080/api/v1

