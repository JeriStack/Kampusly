# ---------------------------------------------------------------------------
# Kampusly Backend — Server-Side Environment Template
# Copy to `backend/.env` when running PHP CLI/tests outside Docker:
#   cp backend/.env.example backend/.env
# NEVER commit `backend/.env` or real credentials to version control.
# ---------------------------------------------------------------------------

APP_NAME=Kampusly
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Manila
LOG_LEVEL=debug

# MySQL PDO Connection
# Inside Docker Compose use DB_HOST=mysql; on host CLI use DB_HOST=127.0.0.1
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kampusly
DB_USERNAME=kampusly_app
DB_PASSWORD=replace_me

# Session & Security Settings
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=kampusly_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# Mail / SMTP Settings (Mailpit locally)
MAIL_ENABLED=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=none
SMTP_FROM_ADDRESS=no-reply@kampusly.local
SMTP_FROM_NAME=Kampusly

