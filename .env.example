# ---------------------------------------------------------------------------
# Kampusly — environment variable template
# Names and placeholders only. NEVER commit real secrets.
# Copy to `.env` for local use: cp .env.example .env
# ---------------------------------------------------------------------------

# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kampusly
DB_USERNAME=kampusly_app
DB_PASSWORD=replace_me
DB_ROOT_PASSWORD=replace_me

# Sessions (local defaults; production must use secure cookies over HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Mail (PHPMailer over SMTP; Mailpit for local inspection)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.test
SMTP_FROM_NAME=Kampusly

# Frontend origin (CORS / cookie behavior)
FRONTEND_ORIGIN=http://localhost:5173
