# Normalize line endings to LF on checkin
* text=auto eol=lf

# Windows-only / binary-safe overrides
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Binary assets (never normalize)
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.svg        text
*.pdf        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary

# Exclude non-shipping files from release archives
/.github         export-ignore
/docs            export-ignore
/.editorconfig   export-ignore
/.gitattributes  export-ignore
/.gitignore      export-ignore
